--swift-version 6.2
--language-mode 5
--indent 4
--maxwidth 110
--wraparguments before-first
--wrapparameters before-first
--semicolons never
--rules indent,linebreaks,spaceAroundOperators,spaceAroundBraces,spaceAroundBrackets,spaceAroundParens,spaceInsideBraces,spaceInsideBrackets,spaceInsideParens,trailingSpace,consecutiveBlankLines,blankLinesBetweenScopes,wrap,wrapArguments,semicolons,sortImports,duplicateImports
